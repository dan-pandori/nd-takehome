# repo-hygiene-2 (2026-09-29): bulk files (.jsonl, .jsonl.gz, .pt, anything > 5 MB) are not tracked. They live in the
# bucket and are listed, with sha256, in artifacts/MANIFEST.jsonl: python3 fetch_artifacts.py <path-or-prefix>.
# New runs publish theirs with publish_artifacts.py. Small files under artifacts/ are tracked. ci/check_sizes.sh
# (pre-commit hook + CI) fails on any tracked file > 5 MB, which .gitignore cannot express.
/artifacts/**/*.jsonl
/artifacts/**/*.jsonl.gz
!/artifacts/MANIFEST.jsonl
*.part
/ckpts/final.pt
/ckpts/stage1_abs.pt
/data/p2/run5_c8d_cands.jsonl
/data/p2/run5_c8d_nec.jsonl
/data/r1/prompts.jsonl
/data/r2/nec_depth4.jsonl
/data/r2/nec_impi_ore.jsonl
/data/r2/nec_ori_ore.jsonl
/data/train.jsonl.gz
data/kh/
# create-or-elicit: bulk files live in hf://buckets/dan-pandori/nd-rl/create-or-elicit/
data/coe/src/
data/coe/*.jsonl.gz
artifacts/coe/ladder/**/found_*.jsonl
artifacts/coe/ladder/**/mix_*.jsonl
artifacts/coe/ladder/**/relabelled_*.jsonl
artifacts/coe/**/dump/
artifacts/coe/**/*.rows.jsonl.gz
artifacts/coe/**/*.repeat.json.gz
artifacts/coe/**/*.steps.jsonl.gz
artifacts/coe/large/
# per-round allocation files (≈ 0.36 MB each, 16 per ladder): uploaded from the pods to the bucket, same paths
artifacts/coe/**/alloc_*.json
artifacts/coe/markers/
ckpts/coe/
pod/coe/GIT_SHA
# proof-strategies: inputs copied from other runs / nd-rl (private), per-record outputs (bucket), scratch
data/ps/in/
artifacts/ps/**/*.jsonl.gz
artifacts/ps/**/*.tsv.gz
artifacts/ps/scratch/
